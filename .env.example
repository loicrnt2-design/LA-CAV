# Copier vers .env.local. Ne jamais commiter de vraies valeurs.
SESSION_SECRET=changez-moi-en-production
DATABASE_FILE=data/lacav.db

# Connecteurs externes : tous désactivés tant qu'ils ne sont pas configurés (voir docs/AVANCEMENT.md)
PAYMENT_PROVIDER=none        # stripe_test pour l'onboarding de test seulement
# STRIPE_TEST_SECRET_KEY=sk_test_...
# APP_BASE_URL=http://localhost:3000
SHIPPING_PROVIDER=none       # mondialrelay | colissimo | chronopost
TRANSLATION_PROVIDER=none
AI_PROVIDER=none
VIDEO_PROVIDER=none
